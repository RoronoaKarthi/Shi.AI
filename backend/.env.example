# Which provider to use. See services/faceSwapProvider.js
# Options: "mock" (no API key needed, for local dev/testing) | "custom" (fill in your chosen provider below)
FACE_SWAP_PROVIDER=mock

# --- Fill these in once you pick a real face-swap API provider ---
# Popular options to evaluate (pricing/ToS/consent policies differ — check each):
#   Segmind Face Swap API, PiAPI Face Swap, Akool, DeepSwap API, Replicate (various face-swap models)
FACE_SWAP_API_KEY=
FACE_SWAP_API_BASE_URL=

PORT=4000

# Max upload size in MB
MAX_UPLOAD_MB=50
